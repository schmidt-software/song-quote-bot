# Local, machine-specific config (contains your Ollama endpoint etc.)
.env

# Local band list, auto-generated by update_bands.sh (see bands.txt.example)
bands.txt

# Local, optional denylist of bands to exclude from the auto-generated list
bands_exclude.txt

# Runtime state / generated data
posted_quotes.json
post_song_quote.log
*.tmp

# Editor / tooling
.claude/

# Unrelated local helper scripts
resume.sh
