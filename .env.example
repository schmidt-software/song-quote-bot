# Copy this file to .env and adjust the values for your setup.
# .env is git-ignored and never committed - keep endpoint/infra details local.

# Base URL of your Ollama server's chat endpoint
OLLAMA_URL="http://localhost:11434/api/chat"

# Any Ollama model that supports structured JSON output (format schema)
OLLAMA_MODEL="llama3.1:8b"

# Nickname used for posts on gettogether.dev (2-20 chars, no spaces)
POST_NAME="songcites"

# Comma-separated list of targets to post to: gettogether, mastodon
POST_TARGETS="gettogether"

# Only needed if POST_TARGETS includes "mastodon":
# - MASTODON_URL: your instance's base URL
# - MASTODON_ACCESS_TOKEN: Settings > Development > New Application
#   (needs at least the write:statuses scope)
# MASTODON_URL="https://mastodon.social"
# MASTODON_ACCESS_TOKEN=""
